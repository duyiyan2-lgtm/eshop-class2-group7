{
  "appId": "top.zhuyiyuan9.eshop",
  "appName": "E-Shop 手机商城",
  "webDir": "dist",
  "backgroundColor": "#f4f4f4",
  "loggingBehavior": "none",
  "android": {
    "backgroundColor": "#f4f4f4",
    "allowMixedContent": false,
    "captureInput": true,
    "loggingBehavior": "none"
  },
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "appStartPath": "/m/products"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#ff5000ff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css"
    }
  }
}
