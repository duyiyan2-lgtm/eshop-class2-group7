{
  "name": "eshop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:android:web": "vite build --mode android",
    "android:add": "cap add android",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:doctor": "cap doctor android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "axios": "^1.8.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vant": "^4.9.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
